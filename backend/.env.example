# Copy this file to .env and fill in real values. .env itself is gitignored -
# never commit real credentials.

SQL_SERVER=YOUR_SQL_SERVER_HERE
SQL_DATABASE=05_Neptune

# SQL Server login (recommended for a Node service running non-interactively -
# unlike the Python script, this backend has no logged-in Windows session to
# borrow trusted auth from). Create a low-privilege SQL login scoped to
# 05_Neptune only.
SQL_USER=neptune_svc
SQL_PASSWORD=

PORT=5051
