<?xml version="1.0" encoding="utf-8"?>
<!--
  Neptune - POD Processor dashboard.
  Lives at the root of dashboard\dist alongside index.html, so IIS picks it
  up automatically. dist\ is regenerated by every "npm run build", so this
  file is kept here in source control and must be copied into dist\ after
  each build (it won't survive a rebuild on its own).

  Two jobs:
    1. URL Rewrite: this is a React single-page app with client-side
       routing. Without this rule, refreshing the browser on anything other
       than "/" (e.g. hitting the Control Mappings tab directly) returns a
       404 from IIS instead of letting React handle the route. The rule
       falls back to index.html for any request that isn't a real file.
    2. Windows Authentication: commented out below. Uncomment and adjust
       once we confirm exactly how Mercury/IC restrict site access on this
       server, so Neptune matches the same pattern instead of introducing a
       different one.

  Note: XML comments cannot contain a double hyphen anywhere in the body
  (only at the very end, closing the comment) - that was the cause of the
  500.19 "not well-formed XML" error the first time this file was deployed.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <rewrite>
      <rules>
        <!-- Let real files (JS, CSS, images, etc.) pass through untouched -->
        <rule name="Neptune SPA serve existing files" stopProcessing="true">
          <match url="^(assets/|neptune-logo\.png|favicon\.ico)" />
          <action type="None" />
        </rule>
        <!-- Everything else falls back to index.html so React Router (or
             this app's own page state) can handle it client-side -->
        <rule name="Neptune SPA fallback to index.html" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!--
    Windows Authentication: uncomment once confirmed against Mercury's
    setup. Also requires the IIS "Windows Authentication" feature to be
    installed (one time, via Server Manager or PowerShell:
      Install-WindowsFeature Web-Windows-Auth
    ) and Anonymous Authentication disabled for this site in IIS Manager,
    since both cannot effectively be relied on at once.

    <security>
      <authentication>
        <anonymousAuthentication enabled="false" />
        <windowsAuthentication enabled="true" />
      </authentication>
    </security>
    -->

    <httpErrors errorMode="Detailed" />
  </system.webServer>
</configuration>
