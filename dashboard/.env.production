# Baked into the build at "npm run build" time. In production the frontend
# is a standalone IIS site with no dev proxy in front of it, so the browser
# needs the backend's real host:port to reach the API at all.
#
# Set this to wherever the Neptune backend actually runs on the server, e.g.:
# VITE_API_BASE=http://neptune-app01:5051
VITE_API_BASE=
